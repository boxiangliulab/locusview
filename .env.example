# locusview environment configuration (example)
#
# 12-Factor principle: configuration lives in the environment, not in source code.
# Copy this file to `.env` and fill in the one real secret. NEVER commit `.env` (it's gitignored).
#
#   cp .env.example .env
#
# Everything below is already filled in EXCEPT LOCUSCOMPARE2_PG_PASSWORD — see that section.

# Where locusview reads its data files (Parquet + tabix). Absolute path recommended.
LOCUSVIEW_DATA_DIR=./data

# Application settings
LOCUSVIEW_ENV=development          # development | production
LOCUSVIEW_LOG_LEVEL=INFO

# Object storage for bulk downloads (Cloudflare R2, S3-compatible) — Phase 1+
# Leave blank until we wire up downloads. Do not paste real credentials here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Legacy: old locuscompare2 MySQL DB (superseded 2026-08 by Postgres, below) ──────────────
# Commented out with LocuscompareRepository in requestinfo.py — not read by _default_repository()
# right now. Kept in case something needs to fall back to it. See docs/process/status.md.
#
# LOCUSCOMPARE2_DB_HOST=54.254.162.217   # provisioned endpoint (swap for a replica/prod host if used)
# LOCUSCOMPARE2_DB_PORT=31987            # Kubernetes NodePort
# LOCUSCOMPARE2_DB_NAME=colotool
# LOCUSCOMPARE2_DB_USER=locusview_test   # public demo/test account (see docs/how-to §0b)
# LOCUSCOMPARE2_DB_PASSWORD=             # secret store / local .env; never committed
# LOCUSCOMPARE2_DB_SSL_MODE=REQUIRED     # require TLS for non-local connections

# ── New locuscompare2 QTL database (PostgreSQL) — what the app actually reads ────────────────
# Schema: see src/backend/locusview/connectpostgres.py's module docstring.
#
# CONNECT DIRECTLY to the host — no SSH tunnel needed (2026-08). The server's docker-compose
# publishes Postgres on host port 15432 (15432 -> container 5432), and that port is reachable from
# the internet. Note 15432 is NOT the same as 5432: the container's own 5432 is unpublished, which
# is what older "you must use an SSH tunnel" instructions were about.
LOCUSCOMPARE2_PG_HOST=18.142.48.203
LOCUSCOMPARE2_PG_PORT=15432
LOCUSCOMPARE2_PG_NAME=locuscompare2
LOCUSCOMPARE2_PG_USER=locuscompare
LOCUSCOMPARE2_PG_DB_SCHEMA=public

# ⚠ THE ONE VALUE YOU MUST FILL IN YOURSELF. Deliberately blank: this repo is PUBLIC on GitHub and
# `gitleaks` blocks commits containing secrets, so the password cannot live here. Ask the team (or
# read it from an existing deployment's secret store), then put it in your local `.env` only:
#
#   LOCUSCOMPARE2_PG_PASSWORD=<ask-the-team>
#
LOCUSCOMPARE2_PG_PASSWORD=
