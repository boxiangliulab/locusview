# locusview environment configuration (example)
#
# 12-Factor principle: configuration lives in the environment, not in source code.
# Copy this file to `.env` and fill in real values. NEVER commit `.env` (it's gitignored).
#
#   cp .env.example .env
#
# Nothing here is required in Phase 0 — these are placeholders for Phase 1 onward.

# Where locusview reads its data files (Parquet + tabix). Absolute path recommended.
LOCUSVIEW_DATA_DIR=./data

# Application settings
LOCUSVIEW_ENV=development          # development | production
LOCUSVIEW_LOG_LEVEL=INFO

# Object storage for bulk downloads (Cloudflare R2, S3-compatible) — Phase 1+
# Leave blank until we wire up downloads. Do not paste real credentials into .env.example.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Legacy: old locuscompare2 MySQL DB (superseded 2026-08 by Postgres, below) ──────────────
# Commented out with LocuscompareRepository in repository.py. See docs/process/status.md.
#
# LOCUSCOMPARE2_DB_HOST=54.254.162.217   # provisioned endpoint (swap for a replica/prod host if used)
# LOCUSCOMPARE2_DB_PORT=31987            # Kubernetes NodePort
# LOCUSCOMPARE2_DB_NAME=colotool
# LOCUSCOMPARE2_DB_USER=locuscompare     # read-only serving account
# LOCUSCOMPARE2_DB_PASSWORD=             # secret store / local .env — never commit a real value
# LOCUSCOMPARE2_DB_SSL_MODE=REQUIRED     # require TLS for non-local connections

# New locuscompare2 QTL database (PostgreSQL) — supersedes the MySQL one above (2026-08).
# Password is injected by the deployment secret store / local .env — never commit a real value.
# See src/backend/locusview/connectpostgres.py's module docstring for the schema.
#
# Connect DIRECTLY to the server — no SSH tunnel needed (2026-08). The server's docker-compose
# publishes Postgres on host port **15432** (15432 -> container 5432), and that port is reachable
# from the internet. Note 15432 is NOT the same as 5432: the container's own 5432 is not published,
# which is what the older "tunnel required" instructions here were about.
#
# Set HOST to the DB server's address (ask the team / see docs/how-to — deliberately not committed
# here) and leave PORT at the published 15432:
LOCUSCOMPARE2_PG_HOST=<db-host>
LOCUSCOMPARE2_PG_PORT=15432
LOCUSCOMPARE2_PG_NAME=locuscompare2
LOCUSCOMPARE2_PG_USER=locuscompare
LOCUSCOMPARE2_PG_PASSWORD=
LOCUSCOMPARE2_PG_DB_SCHEMA=public
